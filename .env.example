# ============================================================================
# CLINICAFY - CONFIGURACIÓN DE ENTORNO
# ============================================================================

# Supabase Cloud / Local
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-admin-key

# Prestador de Firma Electrónica Avanzada (FEA) - e-Cert Chile / Acepta / FirmaGob
FEA_PROVIDER_URL=https://api.e-certchile.cl/fea/v2
FEA_API_KEY=your-fea-api-key
FEA_HSM_TOKEN_SECRET=your-hsm-secret

# Integraciones de Salud (I-Med & Medipass)
IMED_WS_ENDPOINT=https://ws.i-med.cl/bonoelectronico/v3
IMED_PRESTADOR_RUT=76123456-7
IMED_TERMINAL_ID=BOX-PROVI-01
IMED_SECRET_KEY=your-imed-secret

# Pasarelas de Pago E-Commerce
FINTOC_SECRET_KEY=sk_live_...
MERCADOPAGO_ACCESS_TOKEN=APP_USR-...

# Automatizaciones y Mensajería (Meta WhatsApp Cloud API & Correo)
WHATSAPP_CLOUD_API_TOKEN=EAAG...
WHATSAPP_PHONE_NUMBER_ID=109283746501928
RESEND_API_KEY=re_...

# IoT MQTT Broker (EMQX / Mosquitto TLS)
MQTT_BROKER_URL=wss://iot.clinicafy.com/mqtt
MQTT_CLIENT_USERNAME=clinicafy_edge_box01
MQTT_CLIENT_PASSWORD=your-edge-broker-password
